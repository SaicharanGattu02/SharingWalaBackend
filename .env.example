PORT=5000
NODE_ENV=development

# MySQL Database connection string for Prisma
DATABASE_URL="mysql://root:password@localhost:3306/share2go_db"

# JWT Authentication (1 day validity for smooth UX)
JWT_SECRET="share2go_jwt_secret_key_change_me_in_production"
JWT_EXPIRES_IN="1d"

# CORS configuration
CORS_ORIGIN="*"
